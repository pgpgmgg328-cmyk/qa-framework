# Скопируйте в .env и заполните. Все параметры необязательны, кроме OPENAI_API_KEY.

# --- LLM: ProxyAPI (по умолчанию) ---
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.proxyapi.ru/openai/v1
# gpt-5.4-mini — примерно в 4 раза дешевле gpt-4o; gpt-5.4-nano — ещё в 3–4 раза дешевле, но
# проверьте точность на тренировке. При запуске агент проверяет модель и пишет цену фото.
LLM_MODEL=gpt-5.4-mini
# для моделей gpt-5.x: auto — без «обдумывания» (быстро, дёшево); low / medium — точнее, дороже
LLM_REASONING_EFFORT=auto
# Перепроверка: модель не уверена в отправляемом ответе (confidence ниже порога) — решение
# принимает более сильная модель. Например, LLM_MODEL=gpt-5.4-nano и LLM_CHECK_MODEL=gpt-5.4-mini
# LLM_CHECK_MODEL=
# LLM_CHECK_BELOW=0.7
# Цены вашего тарифа за 1 млн токенов «вход,вход из кэша,выход» — стоимость в логе будет в рублях
# (иначе — прайс OpenAI в долларах). Цены — в личном кабинете прокси.
# LLM_PRICE=
# LLM_PRICE_CURRENCY=₽
# --- или OpenRouter (расшифровка аудио через OpenRouter недоступна) ---
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=openai/gpt-5.4-mini

LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=2000
LLM_TIMEOUT=60
LLM_MAX_RETRIES=3
# json_schema strict; если прокси/модель не поддерживает — автоматический откат на json_object
LLM_STRUCTURED_OUTPUT=true
LLM_HISTORY_SIZE=14

# --- Фото для модели ---
# auto — все фото задания (по одному или коллажами с номерами); frame — скриншот фрейма; off — без фото
LLM_VISION=auto
# high — фото в хорошем качестве (детали, надписи, номера на коллажах); low — дешевле, но мельче
LLM_VISION_DETAIL=high
VISION_MAX_IMAGES=36
VISION_SINGLE_MAX=6
# проверка качества по фото (клининг, грязь, дефекты): до стольких фото — по одному, в хорошем разрешении
VISION_DETAIL_MAX=16

# --- Аудио ---
AUDIO_TRANSCRIBE=true
# модели расшифровки по порядку; gpt-4o-transcribe-diarize ещё и размечает говорящих (если доступна).
# Дешевле вдвое: gpt-4o-mini-transcribe,whisper-1
TRANSCRIBE_MODELS=gpt-4o-transcribe,whisper-1
TRANSCRIBE_LANGUAGE=ru
# перед отправкой ответа запись доигрывается до конца («Прослушайте звонок до конца»)
AUDIO_PLAY_TO_END=true

# --- Поиск в интернете (вкладка в том же окне) ---
WEB_RESEARCH=true
SEARCH_URL=https://yandex.ru/search/?text={query}
MAX_WEB_PER_TASK=12

# --- Инструкции и база знаний (папка knowledge) ---
READ_INSTRUCTIONS=true
READ_TOOLTIPS=true
KNOWLEDGE_DIR=knowledge

# --- Браузер ---
# Адрес страницы, с которой вы начинаете работу с заданиями (скопируйте из адресной строки
# браузера, если он другой). Если в логе «сайт с таким адресом не найден» — адрес неверный.
TARGET_URL=https://twork.tbank.ru
# false — видимое окно на весь экран, страница выглядит как в обычном браузере
HEADLESS=false
# Windows: свёрнутое окно браузера агент убирает за край экрана (свёрнутый Chrome не рисует
# страницу, и агент тормозит); вернуть окно — кнопка браузера на панели задач
WINDOW_GUARD=true
# размер и масштаб страницы — только для HEADLESS=true (без окна)
VIEWPORT_WIDTH=1280
VIEWPORT_HEIGHT=720
PAGE_ZOOM=100%
# постоянный профиль: логин сохраняется между запусками
USER_DATA_DIR=.browser-profile
# BROWSER_CHANNEL=chrome
# USER_AGENT=
SLOW_MO=0

# --- Тайминги ---
FRAME_LOAD_WAIT=4.0
ACTION_WAIT=0.4
SUBMIT_WAIT=6.0
SETTLE_QUIET_MS=350
SETTLE_TIMEOUT_MS=4000
CLICK_TIMEOUT_MS=2500
MOUSE_MOVE_STEPS=10
TYPE_DELAY_MS=40

# --- Агент ---
# Агент решает задания, пока платформа не вернёт на список заказов (STOP_ON_ORDERS_LIST=true).
# Потом: false — браузер остаётся открытым, агент ждёт следующий заказ; true — завершить работу
STOP_ON_ORDERS_LIST=true
CLOSE_BROWSER_WHEN_DONE=false
# Экзамен после тренировки агент начинает, только если в тренировке с первого раза верно не меньше
# этой доли ответов (иначе экзамен, скорее всего, не будет сдан). 0 — решать экзамен всегда
EXAM_MIN_ACCURACY=0.8
EXAM_MIN_TASKS=3
# Пакет действий: модель за один ответ отмечает ответы на все вопросы и отправляет (каждое
# действие проверяется). В 2–3 раза меньше вызовов модели. false — одно действие за вызов.
BATCH_ACTIONS=true
MAX_BATCH_ACTIONS=12
# страховочные лимиты
MAX_STEPS=2000
MAX_STEPS_PER_TASK=40
MAX_ELEMENTS=200
MAX_IDLE_SECONDS=900
CAPTCHA_TIMEOUT=600
MAX_OPEN_RETRIES=3
MAX_NO_EFFECT=2

# --- Фреймы и кнопки (через запятую, в нижнем регистре) ---
FRAME_KEYWORDS=klecks-operator,task
# FRAME_IGNORE_KEYWORDS=captcha,about:blank,about:srcdoc
# ALLOW_MAIN_FRAME=false
# START_BUTTON_TEXTS=приступить,начать,ок,ok,хорошо,понятно,продолжить,далее
# FINISH_BUTTON_TEXTS=завершить,отправить,сохранить,готово,submit,finish,save
# стоп-список: эти кнопки агент не показывает LLM и никогда не нажимает
# FINISH_DENY_SUBSTRINGS=смену,смены,сессию,сессии,выйти,выход,logout,аккаунт,завершить работу,доработк

LOG_LEVEL=INFO
# лог каждого запуска — в файл logs/agent-<дата-время>.log (пусто — без файла)
LOG_DIR=logs
